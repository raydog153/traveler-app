# Postgres
POSTGRES_USER=traveler
POSTGRES_PASSWORD=changeme
POSTGRES_DB=traveler
POSTGRES_PORT=5432

# Backend
# Built from the Postgres vars above; only needs overriding if you run the
# backend outside docker-compose (e.g. `postgres` -> `localhost`).
DATABASE_URL=postgresql+psycopg://traveler:changeme@postgres:5432/traveler

# Contact address sent in the User-Agent header for OpenStreetMap Nominatim
# geocoding requests, per Nominatim's usage policy. Use a real address.
NOMINATIM_CONTACT_EMAIL=you@example.com

# Comma-separated list of extra allowed CORS origins. Not needed in the
# default docker-compose dev setup (the Vite dev server proxies /api same-origin) --
# only relevant if you run the frontend against the backend from a different origin.
CORS_ORIGINS=

# Frontend
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Google Maps JavaScript API key for the Guide tab (Maps JavaScript API,
# Places API (New), and Geocoding API must be enabled with billing active).
# This ships to the browser like any client-side Maps key -- it isn't a
# secret, but restrict it in the Google Cloud Console (HTTP referrers) rather
# than relying on it being unlisted.
GOOGLE_MAPS_API_KEY=

# Google AI (Gemini) API key, server-side only, used to read the odometer
# reading off an uploaded fill-up photo. Separate from GOOGLE_MAPS_API_KEY
# above -- this one is never sent to the browser. Get one from
# https://aistudio.google.com/apikey.
GOOGLE_AI_API_KEY=
